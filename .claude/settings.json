{
  "permissions": {
    "allow": [
      "Bash(npx tsc:*)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm run format)",
      "Bash(npm run lint:core)",
      "Bash(npm run lint:dup)",
      "Bash(npm run lint:unused)",
      "Bash(npm run lint:todo)",
      "Bash(npm run lint:docs)",
      "Bash(npm run lint:house)",
      "Bash(npm run i18n:check)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/house-rules.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/markers.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/turn-end-checks.sh",
            "timeout": 300,
            "statusMessage": "Typecheck and tests"
          }
        ]
      }
    ]
  }
}
