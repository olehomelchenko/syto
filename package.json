{
  "name": "syto",
  "version": "0.5.0",
  "private": true,
  "description": "Browser-based data wrangling tool",
  "type": "module",
  "bin": {
    "syto": "./dist-cli/cli.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run docs:generate && tsc && vite build && tsx scripts/build-content-pages.ts",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist-cli/cli.mjs --external:papaparse --external:arquero --external:i18next --external:jsep --banner:js='import { createRequire } from \"module\"; const require = createRequire(import.meta.url);'",
    "preview": "vite preview",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "lint:core": "tsc -p cli.tsconfig.json",
    "lint:house": "node scripts/house-rules.mjs",
    "lint:todo": "node scripts/markers.mjs",
    "lint:docs": "node scripts/doc-pointers.mjs",
    "lint:dup": "jscpd",
    "lint:unused": "knip --max-issues 281",
    "format": "prettier --write .",
    "prepare": "husky",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "docs:generate": "tsx scripts/generate-function-docs.ts",
    "i18n:check": "tsx scripts/check-i18n-keys.ts"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,jsx,css,html,json,md,yml}": "prettier --write"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.1",
    "@codemirror/lint": "^6.9.3",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.12",
    "@duckdb/duckdb-wasm": "^1.33.1-dev20.0",
    "@lezer/highlight": "^1.2.3",
    "@preact/signals": "^2.5.1",
    "@types/dagre": "^0.7.53",
    "arquero": "^6.0.1",
    "codemirror": "^6.0.2",
    "dagre": "^0.8.5",
    "i18next": "^25.8.13",
    "jsep": "^1.4.0",
    "papaparse": "^5.5.1",
    "preact": "^10.28.2",
    "preact-i18next": "^11.8.5",
    "safe-regex2": "^5.1.1",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@testing-library/preact": "^3.2.4",
    "@types/papaparse": "^5.3.15",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.7.0",
    "happy-dom": "^15.11.7",
    "husky": "^9.1.7",
    "jscpd": "5.3.0",
    "knip": "6.37.0",
    "lint-staged": "^16.2.7",
    "marked": "^17.0.2",
    "postcss": "^8.4.49",
    "postcss-nested": "^7.0.2",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-markdown": "^2.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^2.1.8"
  }
}
